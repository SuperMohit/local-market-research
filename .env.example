# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
# Needs an Ollama model with tool calling (for the agents). qwen3.6:35b-a3b needs ~24-26 GB free RAM;
# each run checks free memory before loading it. See README "Hardware" for smaller options.
LLM_MODEL=qwen3.6:35b-a3b
# Relevance filter model; defaults to LLM_MODEL so only one large model is loaded
# FILTER_MODEL=
EMBED_MODEL=qwen3-embedding:0.6b
# ReAct agents: collection tool-call budget, synthesis agent on/off, extra collection calls during synthesis
AGENT_MAX_STEPS=30
SYNTH_AGENT=on
SYNTH_COLLECT_BUDGET=3
# One context size for every call (changing it per call makes Ollama reload the model)
LLM_NUM_CTX=16384
# off | low | medium | high: thinking for extraction (agents use "low"; one-shot synthesis at least "medium")
LLM_THINK=off

# Set to 1 to skip the pre-run free-memory check (not recommended)
# SKIP_MEMORY_CHECK=0

# Final report synthesis: local (Ollama) or claude (needs ANTHROPIC_API_KEY or `ant auth login`).
# "claude" sends the aggregated stats and evidence quotes to the Anthropic API.
SYNTH_PROVIDER=local
CLAUDE_MODEL=claude-opus-5-5

# Browser: "extension" uses your everyday Chrome + OpenCLI extension.
# "cdp" uses a dedicated Chrome profile (log in once with `pnpm cli browser login`), run headless during reports.
BROWSER_MODE=extension
CDP_ENDPOINT=http://127.0.0.1:9333
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Collection
OPENCLI_TIMEOUT_MS=90000
# Pause between browser-driven commands so your logged-in accounts look human
BROWSER_DELAY_MS=2500
CACHE_TTL_HOURS=24
# Web search fallback order: google (opencli), searxng (self-hosted), duckduckgo (opencli)
SEARCH_ORDER=google,searxng,duckduckgo
SEARXNG_URL=http://localhost:8888
